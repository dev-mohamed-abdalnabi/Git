{
  "expo": {
    "name": "GitMobile",
    "slug": "gitmobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0d1117",
    "splash": {
      "backgroundColor": "#0d1117",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.devmohamed.gitmobile",
      "backgroundColor": "#0d1117",
      "permissions": ["READ_EXTERNAL_STORAGE", "WRITE_EXTERNAL_STORAGE"]
    }
  }
}
